# Ali-CTR Lab 环境变量模板
# 复制为 .env 后按需修改（docker compose 会自动读取 .env）

# 注意：数据源（mock/real）不要在这里设，它由 data/active_source.json 决定
# （运行 train_real.sh 后自动切换为 real）。若强行设 ALI_CCP_DATA 会覆盖切换结果。

# 服务绑定地址与端口（生产用 0.0.0.0 公网可访问）
ALI_CCP_HOST=0.0.0.0
ALI_CCP_PORT=8000

# gunicorn worker 数量（多进程并发；内存不足可调低）
GUNICORN_WORKERS=4
